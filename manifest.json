{
  "manifest_version": 3,
  "name": "Universal Limit Tracker",
  "version": "1.0",
  "description": "Track limits for Grok, Perplexity, ChatGPT & more!",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.perplexity.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Limit Tracker"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}