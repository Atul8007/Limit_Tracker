{
  "manifest_version": 3,
  "name": "Perplexity Settings Viewer",
  "description": "Compare free vs Pro Perplexity JSON settings side-by-side.",
  "version": "1.0",
  "icons": {
    "48": "/icon16.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "/icon16.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.perplexity.ai/rest/user/settings"
  ]
}