{
  "manifest_version": 3,
  "name": "Universal Limit Tracker",
  "version": "1.0",
  "description": "Monitors usage limits for APIs and web services with notifications and TTS.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "webRequest",
    "tts"
  ],
  "host_permissions": [
    "*://api.x.ai/*",
    "*://api.anthropic.com/*",
    "*://generativelanguage.googleapis.com/*",
    "*://api.deepseek.com/*",
    "*://grok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}